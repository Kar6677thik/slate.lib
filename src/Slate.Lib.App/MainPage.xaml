<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Slate.Lib.App"
             xmlns:core="clr-namespace:Slate.Lib.Core;assembly=Slate.Lib.Core"
             x:Class="Slate.Lib.App.MainPage"
             HandlerChanged="PageHandlerChanged"
             BackgroundColor="#090A0F">
  <ContentPage.Resources>
    <Color x:Key="PageBackground">#090A0F</Color>
    <Color x:Key="PanelBackground">#12141E</Color>
    <Color x:Key="RaisedBackground">#202436</Color>
    <Color x:Key="Divider">#262B3D</Color>
    <Color x:Key="PrimaryText">#F1F3F9</Color>
    <Color x:Key="SecondaryText">#9BA3B8</Color>
    <Color x:Key="Accent">#8B5CF6</Color>
    <Color x:Key="Success">#34D399</Color>

    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style TargetType="Entry">
      <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
      <Setter Property="PlaceholderColor" Value="#64748B" />
      <Setter Property="BackgroundColor" Value="{StaticResource RaisedBackground}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HeightRequest" Value="34" />
    </Style>
    <Style TargetType="Editor">
      <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
      <Setter Property="PlaceholderColor" Value="#64748B" />
      <Setter Property="BackgroundColor" Value="{StaticResource PageBackground}" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HeightRequest" Value="34" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="#7C3AED" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HeightRequest" Value="34" />
      <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HeightRequest" Value="32" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList><VisualStateGroup Name="CommonStates">
          <VisualState Name="Normal" />
          <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#202436" /></VisualState.Setters></VisualState>
          <VisualState Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="#2A2D43" /></VisualState.Setters></VisualState>
          <VisualState Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.4" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateGroupList>
      </Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="HeightRequest" Value="36" />
      <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
      <Setter Property="ContentLayout" Value="Left,10" />
    </Style>
    <Style x:Key="NavRow" TargetType="Border">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="StrokeShape" Value="RoundRectangle 5" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="HeightRequest" Value="38" />
      <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList><VisualStateGroup Name="CommonStates">
          <VisualState Name="Normal" />
          <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#202436" /></VisualState.Setters></VisualState>
          <VisualState Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="#2A2D43" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateGroupList>
      </Setter>
    </Style>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
      <Setter Property="HeightRequest" Value="32" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList><VisualStateGroup Name="CommonStates">
          <VisualState Name="Normal" />
          <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#202436" /></VisualState.Setters></VisualState>
          <VisualState Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="#2A2D43" /></VisualState.Setters></VisualState>
          <VisualState Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.4" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateGroupList>
      </Setter>
    </Style>
    <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="ContentLayout" Value="Left,7" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
    <Style x:Key="IconButton" TargetType="ImageButton">
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7" />
      <Setter Property="WidthRequest" Value="32" />
      <Setter Property="HeightRequest" Value="32" />
      <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList><VisualStateGroup Name="CommonStates">
          <VisualState Name="Normal" />
          <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#202436" /></VisualState.Setters></VisualState>
          <VisualState Name="Pressed"><VisualState.Setters><Setter Property="BackgroundColor" Value="#2A2D43" /></VisualState.Setters></VisualState>
          <VisualState Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.4" /></VisualState.Setters></VisualState>
        </VisualStateGroup></VisualStateGroupList>
      </Setter>
    </Style>
    <Style x:Key="SectionLabel" TargetType="Label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
      <Setter Property="CharacterSpacing" Value="0.8" />
    </Style>
  </ContentPage.Resources>

  <Grid RowDefinitions="54,Auto,*">
    <Grid Grid.Row="0" RowDefinitions="*,1" BackgroundColor="#0F1117">
      <Grid Padding="16,7" ColumnDefinitions="240,*,Auto,Auto" ColumnSpacing="14">
        <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
          <Image Source="slate_logo.png" WidthRequest="28" HeightRequest="28" />
          <Label Text="Slate" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" CharacterSpacing="0.3" />
          <Border BackgroundColor="#211C33" Stroke="#44336B" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,2" VerticalOptions="Center">
            <Label Text="VAULT" FontFamily="Consolas" FontSize="9" TextColor="#A78BFA" CharacterSpacing="1.1" />
          </Border>
        </HorizontalStackLayout>
        <Border Grid.Column="1" MaximumWidthRequest="580" HorizontalOptions="Center" BackgroundColor="{StaticResource RaisedBackground}" Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 6" WidthRequest="520">
          <Grid ColumnDefinitions="Auto,*,Auto" Padding="10,0" ColumnSpacing="7">
            <Image Source="search_20_regular.png" WidthRequest="17" HeightRequest="17" VerticalOptions="Center" />
            <Entry x:Name="SearchEntry" Grid.Column="1" BackgroundColor="Transparent" Placeholder="Search library…" TextChanged="SearchTextChanged" />
            <Label Grid.Column="2" Text="CTRL  K" FontFamily="Consolas" FontSize="10" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center" />
          </Grid>
        </Border>
        <Border x:Name="SyncStatusSurface" Grid.Column="2" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="7,3" ToolTipProperties.Text="Synchronize the Library with Git">
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="SyncStatusTapped" />
            <PointerGestureRecognizer PointerEntered="SyncStatusPointerEntered" PointerExited="SyncStatusPointerExited" />
          </Border.GestureRecognizers>
          <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
            <Image Source="arrow_sync_20_regular.png" WidthRequest="16" HeightRequest="16" />
            <BoxView x:Name="SyncIndicator" WidthRequest="7" HeightRequest="7" CornerRadius="4" Color="#64748B" VerticalOptions="Center" />
            <Label x:Name="SyncState" Text="Git not initialized" FontSize="12" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center" />
          </HorizontalStackLayout>
        </Border>
        <ImageButton Grid.Column="3" Source="settings_20_regular.png" Style="{StaticResource IconButton}" Clicked="SettingsClicked" ToolTipProperties.Text="Connection settings" SemanticProperties.Description="Connection settings" />
      </Grid>
      <BoxView Grid.Row="1" Color="{StaticResource Divider}" />
    </Grid>

    <Border x:Name="ConnectionPanel" Grid.Row="1" IsVisible="False" BackgroundColor="#141721" Stroke="{StaticResource Divider}" StrokeThickness="0,0,0,1" Padding="18,9">
      <Grid ColumnDefinitions="Auto,*,*,Auto,Auto,Auto" ColumnSpacing="10">
        <VerticalStackLayout WidthRequest="180" Spacing="1" VerticalOptions="Center">
          <Label Text="Connection" FontAttributes="Bold" FontSize="14" />
          <Label Text="Production server and device access" FontSize="11" TextColor="{StaticResource SecondaryText}" />
        </VerticalStackLayout>
        <Entry x:Name="ServerEntry" Grid.Column="1" Placeholder="Server URL" Text="http://localhost:5188" SemanticProperties.Description="Server URL" />
        <Entry x:Name="TokenEntry" Grid.Column="2" Placeholder="Device token" IsPassword="True" SemanticProperties.Description="Device token" />
        <Button Grid.Column="3" Text="Connect" Style="{StaticResource PrimaryButton}" Clicked="ConnectClicked" />
        <ImageButton Grid.Column="4" Source="arrow_sync_20_regular.png" Style="{StaticResource IconButton}" Clicked="ConnectClicked" ToolTipProperties.Text="Reconnect and refresh" SemanticProperties.Description="Reconnect and refresh" />
        <ImageButton Grid.Column="5" Source="dismiss_20_regular.png" Style="{StaticResource IconButton}" Clicked="SettingsClicked" ToolTipProperties.Text="Close settings" SemanticProperties.Description="Close settings" />
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="RailDividerColumn" Width="0" />
        <ColumnDefinition x:Name="RailColumn" Width="0" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,1,Auto,*,Auto" BackgroundColor="{StaticResource PanelBackground}">
        <Grid Padding="14,14,14,9" ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button Text="New" ImageSource="add_20_regular.png" ContentLayout="Left,8" Style="{StaticResource PrimaryButton}" Clicked="NewMenuClicked" HorizontalOptions="Fill" ToolTipProperties.Text="Create a note, folder, or Quick Thought" />
          <ImageButton Grid.Column="1" Source="flash_20_regular.png" Style="{StaticResource IconButton}" Clicked="QuickThoughtClicked" ToolTipProperties.Text="Quick Thought" SemanticProperties.Description="Quick Thought" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Padding="10,2,10,10" Spacing="0">
          <Border Style="{StaticResource NavRow}">
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="InboxClicked" /></Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="11"><Image Source="mail_inbox_20_regular.png" WidthRequest="18" HeightRequest="18" /><Label Text="Inbox" FontSize="14" VerticalOptions="Center" /></HorizontalStackLayout>
          </Border>
          <Border Style="{StaticResource NavRow}">
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="RecentClicked" /></Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="11"><Image Source="history_20_regular.png" WidthRequest="18" HeightRequest="18" /><Label Text="Recent" FontSize="14" VerticalOptions="Center" /></HorizontalStackLayout>
          </Border>
          <Border Style="{StaticResource NavRow}">
            <Border.GestureRecognizers><TapGestureRecognizer Tapped="QuickThoughtClicked" /></Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="11"><Image Source="flash_20_regular.png" WidthRequest="18" HeightRequest="18" /><Label Text="Quick Thought" FontSize="14" VerticalOptions="Center" /></HorizontalStackLayout>
          </Border>
        </VerticalStackLayout>
        <BoxView Grid.Row="2" Margin="20,0" Color="{StaticResource Divider}" />
        <Grid Grid.Row="3" Padding="18,13,12,6" ColumnDefinitions="*,Auto">
          <Label Text="LIBRARY" Style="{StaticResource SectionLabel}" VerticalOptions="Center" />
          <ImageButton Grid.Column="1" Source="add_20_regular.png" Style="{StaticResource IconButton}" Clicked="NewMenuClicked" ToolTipProperties.Text="Create in Library" SemanticProperties.Description="Create in Library" />
        </Grid>
        <CollectionView x:Name="Tree" Grid.Row="4" Margin="7,0,6,0" SelectionMode="Single" SelectionChanged="SelectionChanged" HandlerChanged="TreeHandlerChanged">
          <CollectionView.EmptyView>
            <VerticalStackLayout Margin="14,22" Spacing="6">
              <Label Text="Your library will appear here." FontSize="13" />
              <Label Text="Open Settings to connect." FontSize="12" TextColor="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
          </CollectionView.EmptyView>
          <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:TreeRow">
              <Grid Padding="0,5,4,5" Margin="0,1" ColumnDefinitions="3,*,30" ColumnSpacing="5">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup Name="CommonStates">
                    <VisualState Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="Transparent" /></VisualState.Setters></VisualState>
                    <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#1A1D2B" /></VisualState.Setters></VisualState>
                    <VisualState Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="#29213D" /></VisualState.Setters></VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.GestureRecognizers>
                  <PointerGestureRecognizer PointerEntered="TreeRowPointerEntered" PointerExited="TreeRowPointerExited" />
                </Grid.GestureRecognizers>
                <BoxView Grid.Column="0" WidthRequest="2" Color="{StaticResource Accent}" IsVisible="{Binding Selected}" />
                <Grid Grid.Column="1" ColumnDefinitions="16,20,*" ColumnSpacing="5" Margin="{Binding Indent}">
                  <Image Source="{Binding ChevronIcon}" IsVisible="{Binding ShowChevron}" WidthRequest="13" HeightRequest="13" />
                  <Image Grid.Column="1" Source="{Binding IconSource}" WidthRequest="17" HeightRequest="17" />
                  <Label Grid.Column="2" Text="{Binding Name}" FontSize="13" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                </Grid>
                <ImageButton Grid.Column="2" Source="more_horizontal_20_regular.png" Style="{StaticResource IconButton}" WidthRequest="28" HeightRequest="28" Padding="6" IsVisible="{Binding ShowOverflow}" Clicked="RowOverflowClicked" ToolTipProperties.Text="More actions" SemanticProperties.Description="More actions" />
                <FlyoutBase.ContextFlyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="Open" Clicked="ContextOpen" CommandParameter="{Binding .}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="New note here" Clicked="ContextNewNote" CommandParameter="{Binding .}" />
                    <MenuFlyoutItem Text="New folder here" Clicked="ContextNewFolder" CommandParameter="{Binding .}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Rename" Clicked="ContextRename" CommandParameter="{Binding .}" />
                    <MenuFlyoutItem Text="Cut" Clicked="ContextCut" CommandParameter="{Binding .}" />
                    <MenuFlyoutItem Text="Copy" Clicked="ContextCopy" CommandParameter="{Binding .}" />
                    <MenuFlyoutItem Text="Paste here" Clicked="ContextPaste" CommandParameter="{Binding .}" />
                    <MenuFlyoutItem Text="Duplicate" Clicked="ContextDuplicate" CommandParameter="{Binding .}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Delete…" Clicked="ContextDelete" CommandParameter="{Binding .}" />
                  </MenuFlyout>
                </FlyoutBase.ContextFlyout>
              </Grid>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid Grid.Row="5" Padding="18,12" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="9">
          <ActivityIndicator x:Name="Busy" WidthRequest="16" HeightRequest="16" Color="{StaticResource Accent}" />
          <Label x:Name="Status" Grid.Column="1" Text="Not connected" FontSize="11" TextColor="{StaticResource SecondaryText}" LineBreakMode="TailTruncation" />
          <Label x:Name="ClipboardStatus" Grid.Row="1" Grid.ColumnSpan="2" FontSize="11" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation" />
        </Grid>
      </Grid>

      <BoxView Grid.Column="1" Color="{StaticResource Divider}" />

      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*" BackgroundColor="{StaticResource PageBackground}">
        <Grid Padding="26,14,24,9" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="9">
          <Label x:Name="Breadcrumb" Text="HOME  /  LIBRARY" FontFamily="Consolas" CharacterSpacing="0.8" FontSize="11" TextColor="{StaticResource SecondaryText}" />
          <Label x:Name="DocumentState" Grid.Row="1" Grid.Column="1" Text="" FontSize="11" TextColor="{StaticResource SecondaryText}" VerticalOptions="Center" />
          <Label x:Name="NoteTitle" Grid.Row="1" Text="Library" FontSize="27" FontAttributes="Bold" Margin="0,5,0,0" LineBreakMode="TailTruncation" />
          <ImageButton x:Name="CloseNoteButton" Grid.Row="1" Grid.Column="2" Source="dismiss_20_regular.png" Style="{StaticResource IconButton}" Clicked="CloseNoteClicked" IsVisible="False" ToolTipProperties.Text="Close note" SemanticProperties.Description="Close note" />
        </Grid>

        <Border x:Name="NoteToolbar" Grid.Row="1" Margin="24,0,24,9" Stroke="{StaticResource Divider}" StrokeThickness="1" BackgroundColor="#0F1117" StrokeShape="RoundRectangle 6" Padding="5" IsVisible="False">
          <Grid ColumnDefinitions="Auto,12,Auto,Auto,Auto,Auto,*" ColumnSpacing="3">
            <Border BackgroundColor="{StaticResource RaisedBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 5" Padding="2">
              <HorizontalStackLayout Spacing="0">
                <Button x:Name="WriteButton" Text="Write" ImageSource="edit_20_regular.png" Style="{StaticResource ModeButton}" Clicked="WriteClicked" IsEnabled="False" />
                <Button x:Name="PreviewButton" Text="Preview" ImageSource="eye_20_regular.png" Style="{StaticResource ModeButton}" Clicked="PreviewClicked" IsEnabled="False" />
                <Button x:Name="SplitButton" Text="Split" ImageSource="split_vertical_20_regular.png" Style="{StaticResource ModeButton}" Clicked="SplitClicked" IsEnabled="False" />
              </HorizontalStackLayout>
            </Border>
            <BoxView Grid.Column="1" WidthRequest="1" Margin="5,5" Color="{StaticResource Divider}" />
            <ImageButton x:Name="AttachImageButton" Grid.Column="2" Source="image_20_regular.png" Style="{StaticResource IconButton}" Clicked="AttachImageClicked" IsEnabled="False" ToolTipProperties.Text="Insert image" SemanticProperties.Description="Insert image" />
            <ImageButton x:Name="AttachFileButton" Grid.Column="3" Source="attach_20_regular.png" Style="{StaticResource IconButton}" Clicked="AttachFileClicked" IsEnabled="False" ToolTipProperties.Text="Attach file" SemanticProperties.Description="Attach file" />
            <ImageButton x:Name="InsertLinkButton" Grid.Column="4" Source="link_20_regular.png" Style="{StaticResource IconButton}" Clicked="InsertLinkClicked" IsEnabled="False" ToolTipProperties.Text="Insert wiki link" SemanticProperties.Description="Insert wiki link" />
            <Button x:Name="HistoryButton" Grid.Column="5" Text="History" ImageSource="history_20_regular.png" ContentLayout="Left,7" Style="{StaticResource ToolButton}" Clicked="HistoryClicked" IsEnabled="False" ToolTipProperties.Text="Note history" />
            <Button x:Name="SaveButton" Grid.Column="6" Text="Save" ImageSource="save_20_regular.png" ContentLayout="Left,7" Style="{StaticResource PrimaryButton}" Clicked="SaveClicked" IsEnabled="False" IsVisible="False" HorizontalOptions="End" MinimumWidthRequest="72" />
          </Grid>
        </Border>

        <Grid x:Name="WorkArea" Grid.Row="2" ColumnDefinitions="*,*">
          <Border x:Name="EditorPane" Grid.Column="0" Margin="24,0,6,16" Stroke="#262B3D" StrokeThickness="1" BackgroundColor="#0F1117" StrokeShape="RoundRectangle 5" IsVisible="False">
            <Editor x:Name="MarkdownEditor" TextChanged="EditorTextChanged" HandlerChanged="EditorHandlerChanged" FontFamily="Consolas" FontSize="14" AutoSize="Disabled" Placeholder="Write Markdown…" Margin="12" />
          </Border>
          <Border x:Name="ReaderPane" Grid.Column="1" Margin="6,0,12,16" Stroke="#262B3D" StrokeThickness="1" BackgroundColor="#0F1117" StrokeShape="RoundRectangle 5" IsVisible="False">
            <WebView x:Name="Reader" IsVisible="False" Navigating="ReaderNavigating" HandlerChanged="ReaderHandlerChanged" />
          </Border>
          <VerticalStackLayout x:Name="MessagePanel" Grid.ColumnSpan="2" HorizontalOptions="Center" VerticalOptions="Center" MaximumWidthRequest="480" Padding="30" Spacing="10">
            <Image Source="slate_logo.png" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" />
            <Label x:Name="MessageTitle" Text="Open a note" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,8,0,0" />
            <Label x:Name="MessageDetail" Text="Choose a note from the library or create a new one." FontSize="14" TextColor="{StaticResource SecondaryText}" HorizontalTextAlignment="Center" />
          </VerticalStackLayout>

          <Grid x:Name="SearchPanel" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="{StaticResource PageBackground}" RowDefinitions="Auto,*" Padding="30,10,30,24">
            <Grid ColumnDefinitions="*,Auto">
              <Label x:Name="SearchSummary" Text="Search" FontSize="21" FontAttributes="Bold" VerticalOptions="Center" />
              <ImageButton Grid.Column="1" Source="dismiss_20_regular.png" Style="{StaticResource IconButton}" Clicked="CloseSearchClicked" ToolTipProperties.Text="Close search" SemanticProperties.Description="Close search" />
            </Grid>
            <CollectionView x:Name="SearchResults" Grid.Row="1" SelectionMode="Single" SelectionChanged="SearchResultSelected" Margin="0,14,0,0">
              <CollectionView.EmptyView><Label x:Name="SearchEmpty" Text="Type a query to search the Library." Margin="8,20" TextColor="{StaticResource SecondaryText}" /></CollectionView.EmptyView>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:SearchHit">
                  <Border Padding="15" BackgroundColor="{StaticResource RaisedBackground}" Stroke="{StaticResource Divider}" StrokeThickness="1" StrokeShape="RoundRectangle 6" Margin="0,0,0,9">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                      <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                      <Label Grid.Row="1" Text="{Binding Path}" FontSize="11" TextColor="{StaticResource Accent}" />
                      <Label Grid.Row="2" Text="{Binding Snippet}" FontSize="12" Margin="0,7,0,0" TextColor="{StaticResource SecondaryText}" LineBreakMode="TailTruncation" MaxLines="2" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </Grid>

          <Grid x:Name="HistoryPanel" Grid.ColumnSpan="2" IsVisible="False" BackgroundColor="{StaticResource PageBackground}" RowDefinitions="Auto,*" ColumnDefinitions="300,*" Padding="30,10,30,24">
            <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
              <Label x:Name="HistoryTitle" Text="History" FontSize="21" FontAttributes="Bold" VerticalOptions="Center" />
              <Button Grid.Column="1" Text="Back to current" ImageSource="arrow_left_20_regular.png" ContentLayout="Left,7" Style="{StaticResource ChromeButton}" Clicked="CloseHistoryClicked" />
            </Grid>
            <CollectionView x:Name="HistoryList" Grid.Row="1" SelectionMode="Single" SelectionChanged="HistorySelected" Margin="0,14,12,0">
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="core:NoteHistoryEntry">
                  <VerticalStackLayout Padding="12" Spacing="3">
                    <Label Text="{Binding Message}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Timestamp}" FontSize="11" TextColor="{StaticResource SecondaryText}" />
                    <Label Text="{Binding Commit}" FontSize="10" TextColor="#64748B" LineBreakMode="TailTruncation" />
                  </VerticalStackLayout>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
            <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*" Margin="12,14,0,0">
              <Label x:Name="HistoricalLabel" Text="Choose a version. Historical Markdown is read-only." FontSize="12" TextColor="{StaticResource SecondaryText}" />
              <Editor x:Name="HistoricalEditor" Grid.Row="1" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" FontSize="13" Margin="0,8,0,0" />
            </Grid>
          </Grid>
        </Grid>
      </Grid>

      <BoxView x:Name="RailDivider" Grid.Column="3" Color="{StaticResource Divider}" IsVisible="False" />

      <Grid x:Name="RightRail" Grid.Column="4" RowDefinitions="Auto,1,*" BackgroundColor="{StaticResource PanelBackground}" IsVisible="False">
        <Grid Padding="14,10,14,0" ColumnDefinitions="*,*" RowDefinitions="Auto,2" ColumnSpacing="4">
          <Button x:Name="LinksTabButton" Text="Links" ImageSource="link_20_regular.png" ContentLayout="Left,7" Style="{StaticResource ChromeButton}" Clicked="LinksTabClicked" />
          <Button x:Name="InfoTabButton" Grid.Column="1" Text="Info" ImageSource="info_20_regular.png" ContentLayout="Left,7" Style="{StaticResource ChromeButton}" Clicked="InfoTabClicked" />
          <BoxView x:Name="LinksTabIndicator" Grid.Row="1" Color="{StaticResource Accent}" HeightRequest="2" Margin="10,0" />
          <BoxView x:Name="InfoTabIndicator" Grid.Row="1" Grid.Column="1" Color="{StaticResource Accent}" HeightRequest="2" Margin="10,0" IsVisible="False" />
        </Grid>
        <BoxView Grid.Row="1" Color="{StaticResource Divider}" />
        <ScrollView x:Name="LinksRail" Grid.Row="2">
          <VerticalStackLayout Padding="16,16,16,24" Spacing="10">
            <Label x:Name="BacklinksHeading" Text="BACKLINKS · 0" Style="{StaticResource SectionLabel}" />
            <CollectionView x:Name="BacklinksList" SelectionMode="Single" SelectionChanged="BacklinkSelected" HeightRequest="178">
              <CollectionView.EmptyView><Label Text="No notes link here yet." FontSize="12" TextColor="{StaticResource SecondaryText}" Margin="2,8" /></CollectionView.EmptyView>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:LinkSidebarItem">
                  <Grid Padding="5,7" RowDefinitions="Auto,Auto" ColumnDefinitions="20,*" ColumnSpacing="7">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates">
                      <VisualState Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="Transparent" /></VisualState.Setters></VisualState>
                      <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#202436" /></VisualState.Setters></VisualState>
                      <VisualState Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="#29213D" /></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <Image Source="document_20_regular.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="13" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" FontSize="11" TextColor="{StaticResource SecondaryText}" LineBreakMode="TailTruncation" />
                  </Grid>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
            <BoxView HeightRequest="1" Color="{StaticResource Divider}" Margin="0,4" />
            <Label x:Name="OutgoingHeading" Text="OUTGOING LINKS · 0" Style="{StaticResource SectionLabel}" />
            <CollectionView x:Name="OutgoingList" SelectionMode="Single" SelectionChanged="OutgoingLinkSelected" HeightRequest="230">
              <CollectionView.EmptyView><Label Text="No wiki links in this note." FontSize="12" TextColor="{StaticResource SecondaryText}" Margin="2,8" /></CollectionView.EmptyView>
              <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:LinkSidebarItem">
                  <Grid Padding="5,7" RowDefinitions="Auto,Auto" ColumnDefinitions="20,*" ColumnSpacing="7">
                    <VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates">
                      <VisualState Name="Normal"><VisualState.Setters><Setter Property="BackgroundColor" Value="Transparent" /></VisualState.Setters></VisualState>
                      <VisualState Name="PointerOver"><VisualState.Setters><Setter Property="BackgroundColor" Value="#202436" /></VisualState.Setters></VisualState>
                      <VisualState Name="Selected"><VisualState.Setters><Setter Property="BackgroundColor" Value="#29213D" /></VisualState.Setters></VisualState>
                    </VisualStateGroup></VisualStateManager.VisualStateGroups>
                    <Image Source="document_20_regular.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding Title}" FontSize="13" TextColor="{StaticResource Accent}" LineBreakMode="TailTruncation" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Detail}" FontSize="11" TextColor="{StaticResource SecondaryText}" LineBreakMode="TailTruncation" />
                  </Grid>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
          </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout x:Name="InfoRail" Grid.Row="2" IsVisible="False" Padding="20,20" Spacing="18">
          <VerticalStackLayout Spacing="4">
            <Label Text="PATH" Style="{StaticResource SectionLabel}" />
            <Label x:Name="InfoPath" Text="No note selected" FontSize="13" LineBreakMode="WordWrap" />
          </VerticalStackLayout>
          <VerticalStackLayout Spacing="4">
            <Label Text="REVISION" Style="{StaticResource SectionLabel}" />
            <Label x:Name="InfoRevision" Text="—" FontFamily="Consolas" FontSize="11" TextColor="{StaticResource SecondaryText}" LineBreakMode="TailTruncation" />
          </VerticalStackLayout>
          <VerticalStackLayout Spacing="4">
            <Label Text="DOCUMENT" Style="{StaticResource SectionLabel}" />
            <Label x:Name="InfoWords" Text="0 words · 0 characters" FontSize="13" />
          </VerticalStackLayout>
          <BoxView HeightRequest="1" Color="{StaticResource Divider}" />
          <Label Text="Tip: right-click a library item for rename, move, copy, or delete." FontSize="12" TextColor="{StaticResource SecondaryText}" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
      </Grid>
    </Grid>
  </Grid>
</ContentPage>
