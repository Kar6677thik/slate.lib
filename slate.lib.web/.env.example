NEXT_PUBLIC_SLATE_DEFAULT_SERVER=http://localhost:5080
# Exact origins/base paths allowed by the web proxy. Never put tokens here.
SLATE_ALLOWED_SERVERS=http://localhost:5080
# Optional server-only target for k3s/internal routing. Browser clients still use
# the approved HTTPS identity above; the proxy maps it to this exact trusted URL.
SLATE_UPSTREAM_URL=
# Optional public web origin used for strict browser Origin checks behind a reverse proxy.
SLATE_PUBLIC_ORIGIN=

# Optional derived meaning-search service. Keep every value below server-only.
# Leave the provider disabled to run Slate with Lucene keyword search alone.
SLATE_EMBEDDING_PROVIDER=disabled
SLATE_INTELLIGENCE_DATABASE_URL=
SLATE_EMBEDDING_URL=
SLATE_EMBEDDING_ALLOWED_ORIGINS=
SLATE_EMBEDDING_API_KEY=
SLATE_EMBEDDING_MODEL=text-embedding-3-small
SLATE_EMBEDDING_DIMENSIONS=1536

# Optional Ask Slate generation. Disabled leaves every other Slate feature working.
# The fake provider is deterministic and is accepted only outside production.
SLATE_GENERATION_PROVIDER=disabled
SLATE_GENERATION_URL=
SLATE_GENERATION_ALLOWED_ORIGINS=
SLATE_GENERATION_API_KEY=
SLATE_GENERATION_MODEL=gpt-4.1-mini
SLATE_GENERATION_MAX_INPUT_TOKENS=16000
SLATE_GENERATION_MAX_OUTPUT_TOKENS=1200
SLATE_GENERATION_MAX_CONCURRENCY=2
